{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "postbuild": "cp public/_headers dist/_headers 2>/dev/null; cp public/_redirects dist/_redirects 2>/dev/null; echo 'Post-build: headers and redirects copied'",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "db:init": "chmod +x init_database.sh && ./init_database.sh",
    "db:init:docker": "docker-compose up -d",
    "db:seed": "psql -U postgres -d kasirku -f database_schema.sql",
    "db:migrate": "ls database_migrations/*.sql | sort | while read f; do echo \"Running $f...\"; psql -U postgres -d kasirku -f \"$f\"; done",
    "db:status": "psql -U postgres -d kasirku -c \"SELECT COUNT(*) FROM products; SELECT COUNT(*) FROM transactions; SELECT COUNT(*) FROM store_users;\"",
    "db:backup": "pg_dump -U postgres -d kasirku > backup_$(date +%Y%m%d_%H%M%S).sql",
    "db:restore": "psql -U postgres -d kasirku < backup_$(date +%Y%m%d_%H%M%S).sql"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jsbarcode": "^3.11.4",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "jsbarcode": "^3.12.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-is": "^19.3.0",
    "recharts": "^3.10.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
